# Python bytecode cache (regenerated automatically on every import,
# never needs to travel with the source).
__pycache__/
*.py[cod]
*$py.class

# macOS Finder metadata
.DS_Store

# pytest cache (created automatically on every test run; nothing
# worth committing lives inside)
.pytest_cache/

# Editor / IDE state
.vscode/
.idea/
*.swp
*.swo

# Virtual environment created by an installer, regenerated on each
# machine, never shipped.
/.venv/

# User data & outputs, never committed. Real OptoDrum exports are
# research data belonging to the user.
/data/
/output/

# PyInstaller build output (packaging/build.spec), regenerated by CI
# on every tagged release, never committed.
/build/
/dist/
